#!/bin/bash
set -euo pipefail
ICON_SCRIPTS="$(cd "$(dirname "$0")" && pwd)"
ICON_APP='/Applications/Dreams Time.app'
if [[ ! -d "$ICON_APP" ]]; then
  ICON_USER="$(/usr/bin/stat -f %Su /dev/console)"
  if [[ "$ICON_USER" != root && "$ICON_USER" != loginwindow && -n "$ICON_USER" ]]; then
    ICON_USER_HOME="$(/usr/bin/dscl . -read "/Users/$ICON_USER" NFSHomeDirectory | /usr/bin/sed 's/^NFSHomeDirectory: //')"
    ICON_APP="$ICON_USER_HOME/Applications/Dreams Time.app"
  fi
fi
"$ICON_SCRIPTS/set-app-icon" "$ICON_SCRIPTS/AppIcon.icns" "$ICON_APP"
# Finder's custom-icon metadata leaves the executable, signing requirement,
# activity database, account tokens and macOS permission records untouched.
exit 0
