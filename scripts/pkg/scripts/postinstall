#!/bin/bash
set -euo pipefail
INSTALL_USER="$(/usr/bin/stat -f %Su /dev/console)"
if [[ "$INSTALL_USER" == root || "$INSTALL_USER" == loginwindow || -z "$INSTALL_USER" ]]; then exit 0; fi
INSTALL_UID="$(/usr/bin/id -u "$INSTALL_USER")"
INSTALL_GROUP="$(/usr/bin/id -gn "$INSTALL_USER")"
INSTALL_HOME="$(/usr/bin/dscl . -read "/Users/$INSTALL_USER" NFSHomeDirectory | /usr/bin/sed 's/^NFSHomeDirectory: //')"
INSTALL_DATA="$INSTALL_HOME/Library/Application Support/Dreams Time"
INSTALL_AGENTS="$INSTALL_HOME/Library/LaunchAgents"
/usr/bin/install -d -m 700 -o "$INSTALL_USER" -g "$INSTALL_GROUP" "$INSTALL_DATA"
# A bootstrap is a first-install hint, never an update to the owner's catalog.
# In particular, a generic update's empty template must not erase learned files
# or leave an offline collector without project names to match.
if [[ ! -f "$INSTALL_DATA/bootstrap-projects.json" ]]; then
  /usr/bin/install -m 600 -o "$INSTALL_USER" -g "$INSTALL_GROUP" "$(dirname "$0")/bootstrap-projects.json" "$INSTALL_DATA/bootstrap-projects.json"
fi
/usr/bin/install -d -m 755 -o "$INSTALL_USER" -g "$INSTALL_GROUP" "$INSTALL_AGENTS"
INSTALL_AGENT="$INSTALL_AGENTS/local.dreamstime.start.plist"
cat > "$INSTALL_AGENT" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>local.dreamstime.start</string>
<key>ProgramArguments</key><array><string>/Applications/Dreams Time.app/Contents/MacOS/DreamsTime</string><string>--background</string></array>
<key>RunAtLoad</key><true/>
<key>StartInterval</key><integer>60</integer>
<key>AbandonProcessGroup</key><true/>
<key>ProcessType</key><string>Background</string>
</dict></plist>
PLIST
/usr/sbin/chown "$INSTALL_USER:$INSTALL_GROUP" "$INSTALL_AGENT"
/bin/chmod 644 "$INSTALL_AGENT"
# Remove only the superseded copy of this same app, leaving all data untouched.
INSTALL_OLD="$INSTALL_HOME/Applications/Dreams Time.app"
if [[ -d "$INSTALL_OLD" ]]; then
  INSTALL_IDENTIFIER="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$INSTALL_OLD/Contents/Info.plist" 2>/dev/null || true)"
  if [[ "$INSTALL_IDENTIFIER" == local.dreamstime.companion ]]; then /bin/rm -rf "$INSTALL_OLD"; fi
fi
# Retire the previous GUI as well as its launchd job. An old GUI can otherwise
# survive the file replacement and reopen the new service in legacy mode.
/bin/launchctl bootout "gui/$INSTALL_UID/local.dreamstime.start" 2>/dev/null || true
for INSTALL_PID in $(/usr/bin/pgrep -u "$INSTALL_UID" -x DreamsTime || true); do
  INSTALL_EXECUTABLE="$(/bin/ps -ww -p "$INSTALL_PID" -o comm= || true)"
  if [[ "$INSTALL_EXECUTABLE" == '/Applications/Dreams Time.app/Contents/MacOS/DreamsTime' || "$INSTALL_EXECUTABLE" == "$INSTALL_HOME/Applications/Dreams Time.app/Contents/MacOS/DreamsTime" ]]; then
    /bin/kill -TERM "$INSTALL_PID" 2>/dev/null || true
  fi
done
# Stop the old backend through its own authenticated restart endpoint so its
# database and queued sync requests close cleanly. No account data is replaced.
if [[ -f "$INSTALL_DATA/pairing-token" ]]; then
  INSTALL_PAIRING="$(cat "$INSTALL_DATA/pairing-token")"
  /usr/bin/curl --noproxy '*' --silent --max-time 4 -o /dev/null \
    -H "Authorization: Bearer $INSTALL_PAIRING" -H 'Content-Type: application/json' \
    -d '{"restart":true}' http://127.0.0.1:43123/api/quit || true
  unset INSTALL_PAIRING
  for INSTALL_ATTEMPT in {1..120}; do
    if ! /usr/bin/curl --noproxy '*' --silent --max-time 1 http://127.0.0.1:43123/health >/dev/null; then break; fi
    sleep 0.25
  done
fi
# Activate the new app-owned collector without requiring a logout or manual quit.
/bin/launchctl bootstrap "gui/$INSTALL_UID" "$INSTALL_AGENT" || true
/bin/launchctl asuser "$INSTALL_UID" /usr/bin/sudo -u "$INSTALL_USER" /usr/bin/open '/Applications/Dreams Time.app' || true
exit 0
